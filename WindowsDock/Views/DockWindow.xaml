<Window x:Class="WindowsDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dock"
        Width="400" Height="110"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 幽灵翻页箭头:无底板,只是刻在玻璃上的浅色符号 -->
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根 Grid:下层玻璃面板,上层"图标区 + 分割线 + 固定板块"横排 -->
    <Grid Background="Transparent"
          MouseEnter="Dock_MouseEnter"
          MouseMove="Dock_MouseMove"
          MouseLeave="Dock_MouseLeave">

        <Grid.ContextMenu>
            <ContextMenu Opened="BgMenu_Opened">
                <MenuItem x:Name="MiStartWithWindows" Header="开机自启" IsCheckable="True" Click="MiStartWithWindows_Click"/>
                <MenuItem x:Name="MiAutoHide" Header="自动隐藏(鼠标靠近底边弹出)" IsCheckable="True" Click="MiAutoHide_Click"/>
                <Separator/>
                <MenuItem x:Name="MiIconSizeParent" Header="图标大小">
                    <MenuItem Header="32" Tag="32" IsCheckable="True" Click="MiIconSize_Click"/>
                    <MenuItem Header="36" Tag="36" IsCheckable="True" Click="MiIconSize_Click"/>
                    <MenuItem Header="40" Tag="40" IsCheckable="True" Click="MiIconSize_Click"/>
                    <MenuItem Header="48" Tag="48" IsCheckable="True" Click="MiIconSize_Click"/>
                    <MenuItem Header="56" Tag="56" IsCheckable="True" Click="MiIconSize_Click"/>
                    <MenuItem Header="64" Tag="64" IsCheckable="True" Click="MiIconSize_Click"/>
                </MenuItem>
                <MenuItem x:Name="MiWidthParent" Header="Dock 最大宽度">
                    <MenuItem Header="55% 屏宽" Tag="0.55" IsCheckable="True" Click="MiWidth_Click"/>
                    <MenuItem Header="65% 屏宽" Tag="0.65" IsCheckable="True" Click="MiWidth_Click"/>
                    <MenuItem Header="75% 屏宽" Tag="0.75" IsCheckable="True" Click="MiWidth_Click"/>
                    <MenuItem Header="85% 屏宽" Tag="0.85" IsCheckable="True" Click="MiWidth_Click"/>
                </MenuItem>
                <MenuItem x:Name="MiMagParent" Header="放大倍数">
                    <MenuItem Header="1.25x" Tag="1.25" IsCheckable="True" Click="MiMag_Click"/>
                    <MenuItem Header="1.5x" Tag="1.5" IsCheckable="True" Click="MiMag_Click"/>
                    <MenuItem Header="1.75x" Tag="1.75" IsCheckable="True" Click="MiMag_Click"/>
                    <MenuItem Header="2.0x" Tag="2" IsCheckable="True" Click="MiMag_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="重新扫描桌面" Click="MiRescan_Click"/>
                <MenuItem Header="退出" Click="MiExit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 面板层:玻璃背景(箭头按钮在根层最上方,保证可点击) -->
        <Grid x:Name="PanelZone"
              VerticalAlignment="Bottom"
              Margin="4,0,4,12">
            <Border x:Name="GlassBorder"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#6E101010" Offset="0"/>
                        <GradientStop Color="#96141414" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 一行:分页图标区 | 分割线 | 固定的文件资源管理器板块 -->
        <StackPanel x:Name="Row"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18">

            <Grid x:Name="IconsZone" Background="Transparent">
                <ItemsControl x:Name="DockList"
                              ItemsSource="{Binding Items}"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Left"
                              Background="Transparent">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="{Binding IconAreaHeight}"
                                  Background="Transparent"
                                  MouseLeftButtonUp="Icon_Click">

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="打开" Click="MenuOpen_Click"/>
                                        <MenuItem Header="从 Dock 中移除" Click="MenuRemove_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image x:Name="IconImage"
                                       Grid.Row="0"
                                       Source="{Binding Icon}"
                                       Width="48" Height="48"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       ToolTip="{Binding Name}"
                                       ToolTipService.InitialShowDelay="600"
                                       ToolTipService.Placement="Top"
                                       ToolTipService.VerticalOffset="-6">
                                    <Image.RenderTransform>
                                        <TranslateTransform/>
                                    </Image.RenderTransform>
                                </Image>

                                <!-- 运行指示灯 -->
                                <Ellipse Grid.Row="1"
                                         Width="5" Height="5"
                                         Margin="0,4,0,0"
                                         HorizontalAlignment="Center"
                                         Fill="#F2FFFFFF">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 分割线 -->
            <Border x:Name="Sep"
                    Width="1"
                    Background="#3DFFFFFF"
                    VerticalAlignment="Bottom"/>

            <!-- 常用应用板块:由内置启动计数器选出的前三个常用应用 -->
            <StackPanel x:Name="FreqCells" Orientation="Horizontal">
                <Grid x:Name="FreqCell0"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="FreqCell_Click"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="FreqIcon0" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="FreqCell1"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="FreqCell_Click"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="FreqIcon1" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="FreqCell2"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="FreqCell_Click"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="FreqIcon2" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="FreqCell3"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="FreqCell_Click"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="FreqIcon3" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="FreqCell4"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="FreqCell_Click"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="FreqIcon4" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </StackPanel>

            <!-- 分割线 -->
            <Border x:Name="Sep2"
                    Width="1"
                    Background="#3DFFFFFF"
                    VerticalAlignment="Bottom"/>

            <!-- 固定板块:文件资源管理器 | 此电脑 | 回收站(每页可见) -->
            <StackPanel x:Name="FixedCells" Orientation="Horizontal">
                <Grid x:Name="ExplorerCell"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="ExplorerCell_Click"
                      ToolTip="文件资源管理器"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="ExplorerIcon" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="ThisPcCell"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="ThisPcCell_Click"
                      ToolTip="此电脑"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="ThisPcIcon" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="RecycleBinCell"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="RecycleBinCell_Click"
                      ToolTip="回收站"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="RecycleBinIcon" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid x:Name="EdgeCell"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="EdgeCell_Click"
                      ToolTip="Microsoft Edge"
                      ToolTipService.InitialShowDelay="600" ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-6">
                    <Image x:Name="EdgeIcon" Width="48" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- 分页箭头:根层最上方,保证不被图标层挡住点击;位置由代码按面板几何计算 -->
        <Button x:Name="BtnPrev"
                Style="{StaticResource PageButton}"
                Content="‹"
                Width="24" Height="24"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Visibility="Collapsed"
                ToolTip="上一页(也可用鼠标滚轮)"
                Click="BtnPrev_Click"/>
        <Button x:Name="BtnNext"
                Style="{StaticResource PageButton}"
                Content="›"
                Width="24" Height="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Visibility="Collapsed"
                ToolTip="下一页(也可用鼠标滚轮)"
                Click="BtnNext_Click"/>
    </Grid>
</Window>
